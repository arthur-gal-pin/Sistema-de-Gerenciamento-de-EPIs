# Usada apenas pelo Prisma CLI (migrate/db push/generate), não pelo runtime
# (o runtime usa as variáveis DB_* acima via @prisma/adapter-mssql).
# Se DB_HOST tiver uma instância nomeada (ex: localhost\SQLEXPRESS), ajuste
# o parâmetro de instância conforme a doc do driver mssql, ou use apenas o
# host puro + porta quando possível.
DATABASE_URL = "sqlserver://localhost:x;database=x;user=x;password=x;encrypt=x;trustServerCertificate=x"